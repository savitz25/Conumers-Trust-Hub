# Site
NEXT_PUBLIC_SITE_URL=https://www.asktrusthub.com

# xAI Concierge (server-only — never NEXT_PUBLIC_*)
# https://console.x.ai — OpenAI-compatible API at https://api.x.ai/v1
XAI_API_KEY=
# Optional override (default: grok-4.5)
# XAI_MODEL=grok-4.5

# Google Analytics 4 — cross-domain tracking across all four Trust Hub domains
NEXT_PUBLIC_GA4_ID=G-433BDVV8MJ

# ATH-CUST-002 — Ask-owned business customer database (server-only).
# Production Neon is wired as neon_tech_database (Vercel).
# ASK_DATABASE_URL remains a supported alias.
# Do NOT use the ContractorTrustHub evidence DATABASE_URL here.
# Do NOT put this value in NEXT_PUBLIC_* or client bundles.
# Prefer Vercel Secret type, not Config, for the connection string.
neon_tech_database=
ASK_DATABASE_URL=

# HMAC secret for Florida Contractor claim handoff tokens (>= 32 chars, server-only)
ATH_HANDOFF_SECRET=

# Optional operator minting for /api/internal/handoff/mint (Bearer token)
ATH_OPERATOR_SECRET=

# Staff review allowlist (comma-separated emails)
ATH_STAFF_EMAILS=

# Read-only ContractorTrustHub Postgres for profile validation (SELECT only).
# Server-only. Never expose to the browser. Never used for Layer A writes.
CTH_READ_DATABASE_URL=

# Ask-branded transactional email (Resend). Do not use a ContractorTrustHub from-address.
RESEND_API_KEY=
ASK_AUTH_FROM_EMAIL=Ask Trust Hub <hello@asktrusthub.com>

# Unused placeholders — do not wire these for ATH-CUST-002.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=