# Site
NEXT_PUBLIC_SITE_URL=https://www.asktrusthub.com

# xAI Concierge (server-only — never NEXT_PUBLIC_*)
# https://console.x.ai — OpenAI-compatible API at https://api.x.ai/v1
XAI_API_KEY=
# Optional override (default: grok-4.5)
# XAI_MODEL=grok-4.5

# Google Analytics 4 — cross-domain tracking across all four Trust Hub domains
NEXT_PUBLIC_GA4_ID=G-433BDVV8MJ

# Supabase (optional — for future saved searches, analytics, user profiles)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Clerk Auth (optional — for future user accounts)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...