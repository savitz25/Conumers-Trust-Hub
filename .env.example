# Site
NEXT_PUBLIC_SITE_URL=https://www.asktrusthub.com

# Move specialist handoff origin. Leave unset, or set to the production origin,
# so Ask keeps linking to https://www.movetrusthub.com. On an isolated preview,
# only this reviewed Move deployment is accepted (no wildcard host trust):
# https://move-trust-fe65g6tam-savitz25-s-projects.vercel.app
# Localhost is accepted only with NODE_ENV=development. Journey and attribution
# query parameters on the handoff are preserved. No env change is made by code.
# NEXT_PUBLIC_MOVE_ORIGIN=https://www.movetrusthub.com

# xAI Concierge (server-only — never NEXT_PUBLIC_*)
# https://console.x.ai — OpenAI-compatible API at https://api.x.ai/v1
XAI_API_KEY=
# Optional override (default: grok-4.5)
# XAI_MODEL=grok-4.5

# Google Analytics 4 — cross-domain tracking across all four Trust Hub domains
NEXT_PUBLIC_GA4_ID=G-433BDVV8MJ

# ATH-CUST-002 — Ask-owned business customer database (server-only).
# Production Neon is wired as neon_tech_database (Vercel).
# ASK_DATABASE_URL remains a supported alias.
# Do NOT use the ContractorTrustHub evidence DATABASE_URL here.
# Do NOT put this value in NEXT_PUBLIC_* or client bundles.
# Prefer Vercel Secret type, not Config, for the connection string.
neon_tech_database=
ASK_DATABASE_URL=

# HMAC secret for Florida Contractor claim handoff tokens (>= 32 chars, server-only)
ATH_HANDOFF_SECRET=

# Optional operator minting for /api/internal/handoff/mint (Bearer token)
ATH_OPERATOR_SECRET=

# Sentry (ATH-REL-001A) — org ask-trust-hub / project javascript-nextjs (do not rename).
# DSN and org/project come from env only. Never commit values. DSN is public ingest, not a secret.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Build-only source map upload token. Never NEXT_PUBLIC_*. Set as a Vercel sensitive env var.
SENTRY_AUTH_TOKEN=
# Keep false except for the one Reliability Engineer production closeout event.
SENTRY_PROBE_ENABLED=false
# Optional dedicated probe bearer; falls back to ATH_OPERATOR_SECRET (>= 16 chars).
SENTRY_PROBE_SECRET=

# Staff review allowlist (comma-separated emails)
ATH_STAFF_EMAILS=

# Read-only ContractorTrustHub Postgres for profile validation (SELECT only).
# Server-only. Never expose to the browser. Never used for Layer A writes.
CTH_READ_DATABASE_URL=

# Ask-branded transactional email (Resend). Do not use a ContractorTrustHub from-address.
RESEND_API_KEY=
ASK_AUTH_FROM_EMAIL=Ask Trust Hub <hello@asktrusthub.com>

# Unused placeholders — do not wire these for ATH-CUST-002.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# My TrustHub browser/SSR connection. These names intentionally do not reuse
# the existing AskTrustHub Supabase variables above.
NEXT_PUBLIC_MY_TRUSTHUB_SUPABASE_URL=
NEXT_PUBLIC_MY_TRUSTHUB_SUPABASE_PUBLISHABLE_KEY=

# Closed Stage 1 canary gates. All dependent gates require the master gate.
MY_TRUSTHUB_ENABLED=false
# Preview/dev only. Ignored when VERCEL_ENV is production or unset.
# Opens password sign-in for already-created invited users. Does not open signup,
# email links, recovery mail, or workspace features.
MY_TRUSTHUB_PREVIEW_ACCOUNT_ACCESS=false
MY_TRUSTHUB_SIGNUP_ENABLED=false
MY_TRUSTHUB_SAVED_ENABLED=false
MY_TRUSTHUB_PROJECTS_ENABLED=false
MY_TRUSTHUB_WATCH_ENABLED=false
MY_TRUSTHUB_ALERTS_ENABLED=false
MY_TRUSTHUB_EMAIL_ENABLED=false
MY_TRUSTHUB_EXPORT_ENABLED=false
MY_TRUSTHUB_DELETE_ENABLED=false
MY_TRUSTHUB_SPECIALIST_HANDOFF_ENABLED=false
MY_TRUSTHUB_SOURCE_MONITORING_ENABLED=false

# Server-only canary admission configuration.
MY_TRUSTHUB_CANARY_ONLY=true
MY_TRUSTHUB_CANARY_EMAILS=
MY_TRUSTHUB_CANARY_USER_IDS=

# Local one-time Auth Admin script only. Never expose or set with NEXT_PUBLIC_.
MY_TRUSTHUB_CANARY_EMAIL=
MY_TRUSTHUB_SUPABASE_URL=
MY_TRUSTHUB_SUPABASE_SECRET_KEY=
MY_TRUSTHUB_CONFIRM_CREATE=
MY_TRUSTHUB_ALLOW_EXISTING_UNRELATED_USERS=
